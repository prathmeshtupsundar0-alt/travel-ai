{
  "info": { "name": "Traveling AI API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{"key":"baseUrl","value":"http://localhost:5000/api"},{"key":"token","value":""},{"key":"userId","value":""},{"key":"tripId","value":""},{"key":"expenseId","value":""}],
  "item": [
    {"name":"Health","item":[{"name":"Server Health","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]}]},
    {"name":"Authentication","item":[
      {"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"},"url":"{{baseUrl}}/auth/register"}},
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Response has token', () => pm.expect(pm.response.json().token).to.be.a('string'));","pm.collectionVariables.set('token', pm.response.json().token);","pm.collectionVariables.set('userId', pm.response.json().user.id);"]}}]}]},
    {"name":"Users","item":[{"name":"Get Profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/users/profile"}}]},
    {"name":"Trips","item":[
      {"name":"Create Trip","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"destination\": \"Paris\",\n  \"startLocation\": \"Pune\",\n  \"days\": 5,\n  \"travelers\": 2,\n  \"budget\": 100000,\n  \"preference\": \"Culture\"\n}"},"url":"{{baseUrl}}/trips"},"event":[{"listen":"test","script":{"exec":["pm.test('Created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('tripId', pm.response.json().trip._id);"]}}]},
      {"name":"Get All Trips","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/trips"}},
      {"name":"Get Trip","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/trips/{{tripId}}"}},
      {"name":"Update Trip","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"budget\": 90000}"},"url":"{{baseUrl}}/trips/{{tripId}}"}},
      {"name":"Delete Trip","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/trips/{{tripId}}"}}]},
    {"name":"AI","item":[{"name":"Generate Itinerary","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"tripId\": \"{{tripId}}\"}"},"url":"{{baseUrl}}/ai/generate-itinerary"}}]},
    {"name":"Expenses","item":[
      {"name":"Create Expense","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"category\":\"Food\",\"title\":\"Dinner\",\"amount\":850}"},"url":"{{baseUrl}}/expenses/{{tripId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('expenseId', pm.response.json().expense._id);"]}}]},
      {"name":"Get Expenses","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/expenses/{{tripId}}"}},
      {"name":"Update Expense","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"amount\":900}"},"url":"{{baseUrl}}/expenses/item/{{expenseId}}"}},
      {"name":"Delete Expense","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/expenses/item/{{expenseId}}"}}]}
  ]
}
