{
  "name": "travelai-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs');const html=fs.readFileSync('dist/index.html');['login','register','dashboard','trips','trips/new'].forEach(p=>{fs.mkdirSync('dist/'+p,{recursive:true});fs.writeFileSync('dist/'+p+'/index.html',html)});fs.writeFileSync('dist/404.html',html);\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  }
}
